{
    "name": "shahinmoyshan/pusher-php-server",
    "description": "Pusher Client fine-tuned for tinymvc/spark php framework",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "tinymvc/tinycore": "^4.1 || dev-main"
    },
    "autoload": {
        "psr-4": {
            "Pusher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php"
    }
}
